# --- Supabase (Project Settings → API) ---
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
# Clé secrète (service_role) : serveur uniquement, jamais exposée au navigateur
SUPABASE_SECRET_KEY=sb_secret_xxx

# --- Envoi des e-mails (SMTP de la boîte de l'académie) ---
# Gmail / Google Workspace : smtp.gmail.com, port 465, SMTP_SECURE=true,
# mot de passe = « mot de passe d'application » (compte Google → Sécurité → Validation en 2 étapes)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=contact@exemple.fr
SMTP_PASSWORD=
# Expéditeur affiché
EMAIL_FROM="Académie Delaveau <contact@exemple.fr>"
# Optionnel : adresse de réponse
EMAIL_REPLY_TO=

# --- Tâche planifiée Vercel (chaîne aléatoire de 16 caractères minimum) ---
CRON_SECRET=

# --- URL publique de l'application ---
APP_URL=http://localhost:3000
