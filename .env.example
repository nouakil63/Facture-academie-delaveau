# =============================================================================
# Variables d'environnement — Facturation Académie Delaveau
# En local : copier ce fichier en .env.local et le compléter.
# Sur Vercel : Project → Settings → Environment Variables (mêmes noms).
# =============================================================================

# --- Supabase (Project Settings → API Keys) ---
# URL du projet (Project Settings → Data API → Project URL)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
# Clé « publishable » (commence par sb_publishable_)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
# Clé « secret » (commence par sb_secret_) : serveur uniquement, jamais exposée au navigateur.
# Utilisée seulement par la tâche planifiée (génération et envoi automatiques).
SUPABASE_SECRET_KEY=sb_secret_xxx

# --- Envoi des e-mails : boîte contact@academiedelaveau.com hébergée chez Amen ---
# Serveur SMTP : à vérifier dans l'espace client Amen (Messagerie → paramètres de la boîte).
# Selon l'offre : smtp-fr.securemail.pro ou smtp.amen.fr
SMTP_HOST=smtp-fr.securemail.pro
# 465 + SMTP_SECURE=true (SSL/TLS, recommandé)  —  ou 587 + SMTP_SECURE=false (STARTTLS)
SMTP_PORT=465
SMTP_SECURE=true
# Identifiant = adresse e-mail complète de la boîte
SMTP_USER=contact@academiedelaveau.com
# Mot de passe de la boîte mail (celui du webmail Amen)
SMTP_PASSWORD=
# Expéditeur affiché dans les e-mails envoyés aux familles
EMAIL_FROM="Académie Delaveau <contact@academiedelaveau.com>"
# Facultatif : adresse de réponse, si elle diffère de l'expéditeur
EMAIL_REPLY_TO=

# --- Tâche planifiée Vercel (génération mensuelle automatique) ---
# Chaîne aléatoire d'au moins 32 caractères, par exemple : openssl rand -hex 32
CRON_SECRET=
